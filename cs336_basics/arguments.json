{
    "data_path": "data/TinyStoriesV2-GPT4-train.txt",

    "train":{
        "max_steps": 10000,
        "batch_size": 64,
        "context_length": 256
    },

    "embedding_module":{
        "embedding_dim": 512
    },

    "transformer":{
        "num_layers": 4, 
        "num_heads": 16,
        "d_ff": 1344,
        "vocab_size": 10000,
        "rope_theta": 10000
    },

    "adamW": {
        "learning_rate": 1e-3,
        "weight_decay": 0.01,
        "beta1": 0.9,
        "beta2": 0.999,
        "eps": 1e-8
    },

    "tokenizer":{
        "name": "BPETokenizer",
        "if_trained": true,
        "train_input_path": "",
        "special_tokens": ["<|endoftext|>"],

        "vocab_file_path": "data/TinyStoriesV2-GPT4-train-vocab.pkl",
        "merges_file_path": "data/TinyStoriesV2-GPT4-train-merges.pkl"
    },

    "generator":{
        "temperature": 0.5,
        "probability": 0.85
    }
}
